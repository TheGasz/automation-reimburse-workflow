# Application Settings
APP_NAME="KlaimKilat AI — Smart Expense & Reimbursement Agent"
APP_ENV="development"
DEBUG=true
AUTO_APPROVE_THRESHOLD_IDR=250000
MAX_RECEIPT_AGE_DAYS=14
OCR_MIN_CONFIDENCE=0.65

# DeepSeek / OpenAI-Compatible LLM Configuration
DEEPSEEK_API_KEY="sk-your-deepseek-api-key"
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
DEEPSEEK_MODEL="deepseek-chat"
VISION_MODEL="deepseek-vl2"
LLM_MOCK_FALLBACK=true

# Database & Vector Search (PostgreSQL + pgvector)
DATABASE_URL="postgresql://klaimkilat:klaimkilat_secret@localhost:5432/klaimkilat_db"
USE_IN_MEMORY_DB_FALLBACK=true
EMBEDDING_DIMENSION=1024

# Redis Queue Configuration
REDIS_URL="redis://localhost:6379/0"
USE_LOCAL_QUEUE_FALLBACK=true

# Omnichannel Bot Credentials (Telegram & WhatsApp Gateway)
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_FINANCE_MANAGER_CHAT_ID="987654321"
WHATSAPP_GATEWAY_URL="http://localhost:3001"
WHATSAPP_API_KEY="your-whatsapp-gateway-key"

# Token Cost Estimation (DeepSeek V3 Pricing in IDR)
COST_PER_1K_PROMPT_TOKENS_IDR=2.2
COST_PER_1K_COMPLETION_TOKENS_IDR=4.5
